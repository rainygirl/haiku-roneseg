#!/bin/sh
set -eu
runtime=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
unset PYTHONPATH LIBUNICORN_PATH
exec python3 -I -B -c 'import runpy,sys; sys.path.insert(0,sys.argv[1]); sys.argv=sys.argv[2:]; runpy.run_path(sys.argv[0],run_name="__main__")' "$runtime" "$runtime/receiver_worker.py" "$runtime/../link-auth.bin" "$@"
